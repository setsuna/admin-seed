# API配置
VITE_API_BASE_URL=/api/v1
VITE_REQUEST_TIMEOUT=10000
VITE_ENABLE_REQUEST_LOG=false

# 应用配置
VITE_APP_TITLE=管理后台
VITE_APP_VERSION=0.1.0
VITE_COMPANY_NAME=Your Company

# 密码传输 RSA 加密，必须与后端 CRYPTO_ENABLE 保持一致
VITE_CRYPTO_ENABLE=false

# 默认界面密度：comfortable（舒展卡片风）/ compact（紧凑数据风）
# 用户仍可在右上角主题面板里切换，选择会记在浏览器里
VITE_UI_DENSITY=comfortable
