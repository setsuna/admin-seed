# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=release

# 超时配置
READ_TIMEOUT=10
WRITE_TIMEOUT=10


# 授权配置
LICENSE_DIR=./config
LICENSE_FILE=system.license

# JWT配置
JWT_SECRET=your-secret-key-change-me-in-production
JWT_EXPIRES_IN=24
JWT_REFRESH_EXPIRES_IN=168
JWT_ISSUER=meeting-api

# 数据库配置
DB_DRIVER=sqlite3
DB_DSN=./data/data.db
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_MAX_LIFETIME=60

# 限流配置
RATE_LIMIT_ENABLE=false
RATE_LIMIT_RPS=10.0
RATE_LIMIT_BURST=20

# 文件配置
MAX_FILE_SIZE=100
FILE_STORAGE_ROOT=./files
FILE_ENCRYPTION_KEY=change-me-to-secure-key-32-chars
FILE_MAX_SIZE=104857600  # 100MB 字节
FILE_CHUNK_SIZE=8192     # 8KB
FILE_CLEANUP_INTERVAL=60 # 60分钟
FILE_TEMP_DIR=./tmp

# 打包配置
PACKAGE_ENCRYPTION_KEY=package-encryption-key-32-chars!!
PACKAGE_STORAGE_ROOT=./files/packages

# 挂载监控配置
MOUNT_ENABLED=true
MOUNT_MONITOR_TYPE=fsnotify # fsnotify polling 两种方式
MOUNT_POLL_INTERVAL=10
MOUNT_BASE_PATH=/media
MOUNT_AUTO_PROCESS=true
# 设备端应用数据目录名（以 . 开头默认隐藏；须与平板端 APP_EXTERNAL_ROOT 末级一致）
# 注意：值后面不要留空格，否则会成为目录名的一部分
MOUNT_APP_DATA_DIR=.sealmeet

# 挂载同步配置
MOUNT_MAX_CONCURRENT_TASKS=2        # 最大并发任务数
MOUNT_TASK_QUEUE_SIZE=20           # 任务队列大小
MOUNT_PROGRESS_UPDATE_INTERVAL=1    # 进度更新间隔（秒）
MOUNT_PROGRESS_UPDATE_BYTES=1048576 # 进度更新字节数（1MB）
MOUNT_TASK_TIMEOUT=30               # 任务超时时间（分钟）

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=console  # console 或 json
LOG_OUTPUT=stdout   # stdout 或 file
LOG_FILENAME=logs/app.log
LOG_MAX_SIZE=100    # MB
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30      # 天
LOG_COMPRESS=true

# 密码传输 RSA 加密（种子默认关闭；开启前请先生成 certs/private_key.pem）
CRYPTO_ENABLE=false
